#!/usr/bin/env bash
#
# pre-commit — GitNexus block staleness detector
#
# Runs before every `git commit`. Fails (blocks the commit) if the
# GitNexus stats embedded in AGENTS.md or CLAUDE.md don't match the
# current .gitnexus/meta.json index statistics.
#
# Installation (one-time):
#   git config core.hooksPath githooks
#
# Rationale: The gitnexus block in AGENTS.md / CLAUDE.md embeds a live
# snapshot of the knowledge-graph stats (symbol count, relationship count).
# Stale stats mislead anyone reading those files. Contributors are supposed
# to run `npx gitnexus analyze --force` before committing if they edited
# any file, but this hook enforces that automatically.
#

set -euo pipefail

META_JSON=".gitnexus/meta.json"

guard_skip() {
  local reason="$1"
  echo "info: $reason — skipping staleness check" >&2
  exit 0
}

[[ -f "$META_JSON" ]] || guard_skip "no .gitnexus/meta.json"
[[ -s "$META_JSON" ]] || guard_skip "meta.json is empty"

python3 << 'PYEOF'
import json, os, re, sys

# ── Read reference values from meta.json ──────────────────────────────────────
meta_path = '.gitnexus/meta.json'
try:
    with open(meta_path) as f:
        d = json.load(f)
    nodes_meta = str(d['stats']['nodes'])
    edges_meta = str(d['stats']['edges'])
except Exception as e:
    print(f"warn: Could not parse {meta_path}: {e} — skipping", file=sys.stderr)
    sys.exit(0)

if not nodes_meta or not edges_meta:
    print(f"warn: stats missing from {meta_path} — skipping", file=sys.stderr)
    sys.exit(0)

# ── Extract stats from a file's gitnexus block ────────────────────────────────
REPO = 'skill-library'
BLOCK_PAT = re.compile(r'<!-- gitnexus:start -->(.*?)<!-- gitnexus:end -->', re.DOTALL)
STATS_PAT = re.compile(r'\*\*' + REPO + r'\*\*.*?\((\d+) symbols,\s*(\d+) relationships')
#                                                    ^^^ captures node count ^^^^^^^^^^^^^^^^
#                                                                        ^captures edge count

def extract_stats(file_path):
    try:
        with open(file_path) as f:
            content = f.read()
    except (IOError, OSError):
        return None, None

    m = BLOCK_PAT.search(content)
    if not m:
        return None, None   # no block → nothing to check

    sm = STATS_PAT.search(m.group(1))
    if not sm:
        return None, None   # no stats line → nothing to check

    return int(sm.group(1)), int(sm.group(2))

# ── Check one file ──────────────────────────────────────────────────────────────
def check_file(path):
    nodes, edges = extract_stats(path)
    if nodes is None and edges is None:
        return True  # no block / no stats line — nothing to check, pass

    if nodes != int(nodes_meta) or edges != int(edges_meta):
        print(f"STALE GITNEXUS BLOCK in {path}:", file=sys.stderr)
        print(f"  File:       {nodes} symbols, {edges} relationships", file=sys.stderr)
        print(f"  meta.json:  {nodes_meta} symbols, {edges_meta} relationships", file=sys.stderr)
        print("", file=sys.stderr)
        print("  Fix: run 'npx gitnexus analyze --force' then re-commit", file=sys.stderr)
        return False
    return True

# ── Main ────────────────────────────────────────────────────────────────────────
files = ['AGENTS.md', 'CLAUDE.md']
all_pass = True
for f in files:
    if not check_file(f):
        all_pass = False

if not all_pass:
    print("", file=sys.stderr)
    print("error: Commit blocked — stale GitNexus block(s) detected above.", file=sys.stderr)
    sys.exit(1)

sys.exit(0)
PYEOF